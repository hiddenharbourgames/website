#!/usr/bin/env python3
"""Vor dem Livegang: keine Platzhalter, keine toten lokalen Verweise, CNAME stimmt."""
import pathlib, re, sys

root = pathlib.Path(__file__).parent
fails = []
for page in root.glob("*.html"):
    text = page.read_text()
    if "OFFEN" in text or 'href="#"' in text:
        fails.append(f"Platzhalter in {page.name}")
    for ref in re.findall(r'(?:href|src)="([^"]*)"', text):
        ref = ref.split("#")[0]
        if ref and ":" not in ref and not (root / ref).exists():
            fails.append(f"{page.name}: fehlt {ref}")
for ref in re.findall(r"url\('?([^)']+)'?\)", (root / "style.css").read_text()):
    if not (root / ref).exists():
        fails.append(f"style.css: fehlt {ref}")
if (root / "CNAME").read_text().strip() != "hiddenharbourgames.com":
    fails.append("CNAME falsch")
print("\n".join(fails) or "CHECK PASS")
sys.exit(1 if fails else 0)
