#!/usr/bin/env python3
"""Vor dem Livegang: keine Platzhalter, keine toten lokalen Verweise oder Sprungziele, CNAME stimmt."""
import pathlib, re, sys
from html.parser import HTMLParser
import posixpath
from urllib.parse import unquote, urlsplit

root = pathlib.Path(__file__).parent


class Page(HTMLParser):
    def __init__(self):
        super().__init__()
        self.refs, self.ids = [], set()

    def handle_starttag(self, tag, attrs):
        for k, v in attrs:
            if k in ("href", "src") and v is not None:
                self.refs.append(v)
            if k == "id" and v:
                self.ids.add(v)


def parse(rel):
    p = Page()
    p.feed((root / rel).read_text())
    return p


pages = {f.name: (parse(f.name), f.read_text()) for f in root.glob("*.html")}

fails = []
for name, (p, text) in pages.items():
    if "OFFEN" in text:
        fails.append(f"Platzhalter in {name}")
    for ref in p.refs:
        u = urlsplit(ref.strip())
        if u.scheme or u.netloc:
            continue
        target = posixpath.normpath(unquote(u.path)) if u.path else name
        frag = unquote(u.fragment)
        if not (root / target).exists():
            fails.append(f"{name}: fehlt {target}")
        elif frag and target.endswith(".html") and frag not in (pages[target][0] if target in pages else parse(target)).ids:
            fails.append(f"{name}: Sprungziel #{frag} fehlt in {target}")
        elif ref.strip() == "#":
            fails.append(f"{name}: leerer Link #")
for ref in re.findall(r"url\(\s*['\"]?([^'\")]+)['\"]?\s*\)", (root / "style.css").read_text()):
    if not (root / urlsplit(ref).path).exists():
        fails.append(f"style.css: fehlt {ref}")
if (root / "CNAME").read_text().strip() != "hiddenharbourgames.com":
    fails.append("CNAME falsch")
print("\n".join(fails) or "CHECK PASS")
sys.exit(1 if fails else 0)
